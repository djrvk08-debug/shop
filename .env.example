# Flask configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-in-production-to-a-random-secret-key

# Database connection URL
# Optional override. If unset, automatically resolves to absolute path: instance/shop.db
# DATABASE_URL=sqlite:////absolute/path/to/shop/instance/shop.db

# Admin user creation defaults (used by `flask create-admin`)
ADMIN_MOBILE=+919876543210
ADMIN_PASSWORD=admin123

# OTP and SMS delivery
OTP_SECRET=replace-with-a-long-random-secret
SMS_PROVIDER=console
# Console delivery is allowed only with FLASK_DEBUG=1. For production use Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_TEMPLATE_ID=

# Carrier webhook authentication (required to accept carrier updates)
CARRIER_WEBHOOK_TOKEN=replace-with-a-long-random-token

# Notification service credentials (TODO: configure in production)
# SMTP_SERVER=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=notifications@example.com
# SMTP_PASSWORD=secret
