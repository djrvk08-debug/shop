# Flask configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-in-production-to-a-random-secret-key

# Database connection URL
# Optional override. If unset, automatically resolves to absolute path: instance/shop.db
# DATABASE_URL=sqlite:////absolute/path/to/shop/instance/shop.db

# Admin user creation defaults (used by `flask create-admin`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Notification service credentials (TODO: configure in production)
# SMTP_SERVER=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=notifications@example.com
# SMTP_PASSWORD=secret
